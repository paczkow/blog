---
import { SITE } from "config";

interface Props {
  ariaLabel: string;
  class?: string;
}

const { ariaLabel, class: className } = Astro.props;

const links = [
  { label: "GitHub", href: SITE.social.github, external: true },
  { label: "LinkedIn", href: SITE.social.linkedin, external: true },
  // Carried over from the home page's About paragraph, which the Experience
  // timeline replaced: the sidebar is the only place left that offers a way to
  // reach me, so the link moved here rather than being dropped.
  { label: "Bluesky", href: SITE.social.bluesky, external: true },
  { label: "RSS", href: "/rss.xml", external: false },
];

const linkClass =
  "text-sub transition-colors duration-150 hover:text-ink touch:active:text-ink";
---

<nav
  aria-label={ariaLabel}
  class:list={["text-sub flex gap-[18px] text-xs", className]}
>
  {
    links.map((link) => (
      <a
        href={link.href}
        class={linkClass}
        {...(link.external
          ? { target: "_blank", rel: "noopener noreferrer" }
          : {})}
      >
        {link.label} <span aria-hidden="true">↗</span>
      </a>
    ))
  }
</nav>
