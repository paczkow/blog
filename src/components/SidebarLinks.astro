---
import { SITE } from "config";

interface Props {
  ariaLabel: string;
  class?: string;
}

const { ariaLabel, class: className } = Astro.props;

const links = [
  { label: "GitHub", href: SITE.social.github, external: true },
  { label: "LinkedIn", href: SITE.social.linkedin, external: true },
  { label: "RSS", href: "/rss.xml", external: false },
];

const linkClass =
  "text-sub transition-colors duration-150 hover:text-ink touch:active:text-ink";
---

<nav
  aria-label={ariaLabel}
  class:list={["text-sub flex gap-[18px] font-mono text-xs", className]}
>
  {
    links.map((link) => (
      <a
        href={link.href}
        class={linkClass}
        {...(link.external
          ? { target: "_blank", rel: "noopener noreferrer" }
          : {})}
      >
        {link.label} <span aria-hidden="true">↗</span>
      </a>
    ))
  }
</nav>
