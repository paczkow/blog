---
import { Rss } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { SITE } from "config";

interface Props {
  ariaLabel: string;
}

const { ariaLabel } = Astro.props;

const linkClass =
  "text-sand-10 transition-colors hover:text-sand-12 touch:active:text-sand-12";
const iconClass = "h-4 w-4";
---

<nav aria-label={ariaLabel} class="mt-8 flex gap-4">
  <a
    href={SITE.social.github}
    aria-label="GitHub"
    class={linkClass}
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon name="simple-icons:github" class={iconClass} />
  </a>
  <a
    href={SITE.social.linkedin}
    aria-label="LinkedIn"
    class={linkClass}
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon name="simple-icons:linkedin" class={iconClass} />
  </a>
  <a href="/rss.xml" aria-label="RSS" class={linkClass}>
    <Rss class={iconClass} />
  </a>
</nav>
