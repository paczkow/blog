---
import Card from "@/components/Card.astro";
import SidebarLinks from "@/components/SidebarLinks.astro";
import WritingHeatmap from "@/components/WritingHeatmap.svelte";
import { getHomePosts, loadWritingPosts } from "@/helpers/page-data.ts";
import { useTranslations } from "@/i18n/utils.ts";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/TwoColumn.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "config";

const lang = "pl" as const;
const { posts: allPosts } = await loadWritingPosts();
const posts = getHomePosts(allPosts, lang);
const t = useTranslations(lang);
const locale = t("common.locale");
const readTimeLabel = t("common.readTime");
const writingHref = getRelativeLocaleUrl(lang, "writing");

const aboutParagraphs = [
  "Hej, jestem Michał.",
  "W skrócie: od zawsze napędza mnie rywalizacja i ciekawość, jak dobry mogę być w tym, co robię.",
  "Najpierw był to sport — jako dziecko byłem pewny, że zostanę sportowcem, a na studiach futsal interesował mnie dużo bardziej niż kod. Z czasem to samo przeniosło się na inżynierię oprogramowania i zaszedłem dalej, niż się spodziewałem. Przez ostatnie 10 lat pracowałem w różnych miejscach — od kilkuosobowych startupów po Amazona i Metę.",
  "Przez cały ten czas wracał do mnie jeden problem: wartościowych rzeczy jest znacznie więcej, niż jesteśmy w stanie utrzymać w głowie. Zacząłem szukać sposobu, żeby to ogarnąć — tak trafiłem na Zettelkasten, Evergreen Notes i naukę z Anki. Z czasem zbudowałem własny system wiedzy i wciąż go rozwijam. Nie kolekcję notatek porzucanych tydzień po zapisaniu, tylko sposób pracy z pomysłami: zamienianie tego, co czytam, w coś, czym naprawdę myślę. Łączenie odległych kontekstów sprawia, że szybciej rozumiem nowe rzeczy — i mam o czym pisać tutaj.",
  "Dokumentuję więc, co próbowałem, co się posypało, a co działa. Pisanie jest tu sprawdzianem: dopiero kiedy próbuję coś wyjaśnić, widzę, czego naprawdę nie rozumiem. Zostawiam mapę, której sam kiedyś mi brakowało. Nic tu nie jest fundamentalną prawdą — to moje doświadczenie i obserwacje.",
];

const heatmapPosts = posts.map((post) => ({
  id: post.id,
  title: post.title,
  date: post.date.toISOString(),
}));
---

<Layout
  title={SITE.title}
  lang={lang}
  isHome
  languageLinks={{
    en: getRelativeLocaleUrl("en"),
    pl: getRelativeLocaleUrl("pl"),
  }}
  alternates={[
    { lang: "en", href: getRelativeLocaleUrl("en") },
    { lang: "pl", href: getRelativeLocaleUrl("pl") },
  ]}
>
  <Fragment slot="sidebar">
    <div class="flex flex-col gap-10 h-full">
      <div class="flex flex-col gap-6">
        <h1
          class="font-display font-normal text-sand-12 text-5xl md:text-5xl leading-[0.95] tracking-tight -mt-3"
        >
          Michał<br />Paczków<span class="text-sand-9 italic">.</span>
        </h1>
        <div class="flex flex-col gap-2">
          <p class="text-sand-12 text-base leading-relaxed lg:max-w-[28ch]">
            {t("home.hero.hook")}
          </p>
          <p
            class="text-sand-12 text-base leading-relaxed lg:max-w-[28ch]"
            set:html={t("home.hero.subtitle")}
          />
        </div>
      </div>

      <nav
        id="section-nav"
        aria-label={t("home.nav.sections")}
        class="hidden lg:flex flex-col gap-4"
      >
        <button
          type="button"
          data-target="essays"
          class="nav-item group relative flex w-full cursor-pointer items-center py-1 text-left"
        >
          <span
            class="nav-line block h-px w-6 bg-sand-7 transition-all duration-200 ease-out group-hover:w-9 group-hover:bg-sand-12 dark:bg-sand-8 dark:group-hover:bg-sand-12"
          ></span>
          <span
            class="nav-label absolute left-12 text-sand-11 text-sm opacity-0 transition-opacity duration-200 group-hover:opacity-100"
          >
            {t("home.nav.writing")}
          </span>
        </button>
        <button
          type="button"
          data-target="about"
          class="nav-item group relative flex w-full cursor-pointer items-center py-1 text-left"
        >
          <span
            class="nav-line block h-px w-6 bg-sand-7 transition-all duration-200 ease-out group-hover:w-9 group-hover:bg-sand-12 dark:bg-sand-8 dark:group-hover:bg-sand-12"
          ></span>
          <span
            class="nav-label absolute left-12 text-sand-11 text-sm opacity-0 transition-opacity duration-200 group-hover:opacity-100"
          >
            {t("home.nav.about")}
          </span>
        </button>
      </nav>

      <div class="mt-auto hidden lg:block">
        <WritingHeatmap
          client:load
          posts={heatmapPosts}
          i18n={{
            locale: t("common.locale"),
            heatmapTitle: t("home.heatmap.title"),
            noWriting: t("home.heatmap.noWriting"),
          }}
        />
        <SidebarLinks ariaLabel={t("common.links")} />
      </div>
    </div>
  </Fragment>
  <Fragment slot="content">
    <div class="flex flex-col gap-24">
      <section id="essays" class="mt-[-116px] flex flex-col gap-8 pt-[116px]">
        <div class="flex items-baseline justify-between px-4">
          <h2
            class="text-sand-11 text-xs uppercase tracking-[0.2em] font-medium"
          >
            {t("home.nav.writing")}
          </h2>
          <a
            href={writingHref}
            class="text-sand-11 text-sm hover:text-sand-12 flex items-center gap-1 transition-colors"
          >
            {t("common.allWriting")}
            <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
          </a>
        </div>
        <div class="group flex flex-col">
          {
            posts
              .slice(0, 4)
              .map((post) => (
                <Card
                  id={post.id}
                  url={post.url}
                  date={post.date}
                  title={post.title}
                  description={post.description}
                  readTime={post.readTime}
                  locale={locale}
                  readTimeLabel={readTimeLabel}
                />
              ))
          }
        </div>
      </section>

      <section id="about" class="flex flex-col gap-6 px-4">
        <h2 class="text-sand-11 text-xs uppercase tracking-[0.2em] font-medium">
          {t("home.about.heading")}
        </h2>
        <div class="flex flex-col gap-5">
          {
            aboutParagraphs.map((paragraph) => (
              <p class="text-sand-12 leading-relaxed">{paragraph}</p>
            ))
          }
          <p class="text-sand-12 leading-relaxed">
            Chcesz pogadać? Napisz na{" "}
            <a
              href={SITE.social.linkedin}
              class="text-sand-12 underline underline-offset-2 decoration-sand-7 transition-colors hover:decoration-sand-12"
            >
              LinkedIn
            </a>{" "}
            albo{" "}
            <a
              href={`mailto:${SITE.email}`}
              class="text-sand-12 underline underline-offset-2 decoration-sand-7 transition-colors hover:decoration-sand-12"
            >
              {SITE.email}
            </a>.
          </p>
        </div>
      </section>
    </div>
  </Fragment>
</Layout>

<style>
  #section-nav .nav-item.active .nav-line {
    width: 36px;
    background: var(--color-sand-12);
  }
  #section-nav .nav-item.active .nav-label {
    opacity: 1;
    color: var(--color-sand-12);
  }
</style>

<script>
  const items = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#section-nav .nav-item"),
  );

  if (items.length > 0) {
    let observerEnabled = true;

    const setActive = (id: string) => {
      items.forEach((item) =>
        item.classList.toggle(
          "active",
          item.getAttribute("data-target") === id,
        ),
      );
    };

    items.forEach((item) => {
      item.addEventListener("click", () => {
        const id = item.getAttribute("data-target");
        if (!id) return;
        const section = document.getElementById(id);
        setActive(id);
        if (section) {
          observerEnabled = false;
          section.scrollIntoView({ behavior: "smooth", block: "start" });
          window.setTimeout(() => {
            observerEnabled = true;
          }, 1000);
        }
      });
    });

    const sections = items
      .map((item) =>
        document.getElementById(item.getAttribute("data-target") ?? ""),
      )
      .filter((s): s is HTMLElement => !!s);

    const onScroll = () => {
      if (!observerEnabled) return;

      const scrollBottom = window.scrollY + window.innerHeight;
      const atBottom =
        scrollBottom >= document.documentElement.scrollHeight - 4;

      if (atBottom) {
        setActive(sections[sections.length - 1]?.id ?? "");
        return;
      }

      const triggerY = window.innerHeight * 0.35;
      let activeId = sections[0]?.id ?? "";

      for (const section of sections) {
        if (section.getBoundingClientRect().top <= triggerY) {
          activeId = section.id;
        }
      }

      setActive(activeId);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
