---
import { getRelativeLocaleUrl } from "astro:i18n";
import ExperienceTimeline from "@/components/ExperienceTimeline.astro";
import GlyphBackground from "@/components/GlyphBackground.svelte";
import HeroTerminal from "@/components/HeroTerminal.svelte";
import PostRow from "@/components/PostRow.astro";
import SectionNav from "@/components/SectionNav.astro";
import SidebarLinks from "@/components/SidebarLinks.astro";
import WritingHeatmap from "@/components/WritingHeatmap.svelte";
import { postListClass } from "@/components/post-row.ts";
import {
  getHomePosts,
  getLocaleStaticPaths,
  loadWritingPosts,
} from "@/helpers/page-data.ts";
import { getLocaleLinks } from "@/helpers/posts.ts";
import { experience } from "@/i18n/experience.ts";
import { useTranslations } from "@/i18n/utils.ts";
import Layout from "@/layouts/TwoColumn.astro";
import { SITE } from "config";

// Home for every locale: the default one has no `lang` param and is served at
// `/`, the rest are prefixed (`/pl`). A paused locale is absent from
// `activeLangs`, so its home simply stops being generated.
export const getStaticPaths = getLocaleStaticPaths;

const { lang } = Astro.props;
const { posts: allPosts } = await loadWritingPosts();
const posts = getHomePosts(allPosts, lang);
const t = useTranslations(lang);
const locale = t("common.locale");
const writingHref = getRelativeLocaleUrl(lang, "writing");
const { alternates, languageLinks } = getLocaleLinks(getRelativeLocaleUrl);

// Home is a teaser for the archive, which holds the rest.
const HOME_POSTS = 4;

// `PostRow` takes preformatted strings and does no date maths, so the locale is
// resolved here.
const rows = posts.slice(0, HOME_POSTS).map((post) => ({
  href: post.url,
  title: post.title,
  description: post.description,
  date: post.date.toLocaleDateString(locale, {
    month: "short",
    day: "2-digit",
    year: "numeric",
  }),
  readTime: `${post.readTime} ${t("common.readTimeShort")}`,
}));

const work = experience[lang];

const navItems = [
  { id: "writing", label: t("home.nav.writing") },
  { id: "experience", label: t("home.nav.experience") },
];

const heatmapPosts = posts.map((post) => ({
  id: post.id,
  title: post.title,
  date: post.date.toISOString(),
}));
---

<Layout
  title={SITE.title}
  lang={lang}
  languageLinks={languageLinks}
  alternates={alternates}
  asideClip
>
  <Fragment slot="sidebar">
    {
      /*
        The glyph field fills the panel behind everything else; each block below
        carries `relative z-[1]` rather than sharing one wrapper so the layout's
        own `--aside-gap` still spaces them and `mt-auto` still reaches the
        panel's bottom.
      */
    }
    <div class="pointer-events-none absolute inset-0 z-0 hidden lg:block">
      <GlyphBackground client:media="(min-width: 1024px)" />
    </div>

    <div class="relative z-[1] flex flex-col gap-5">
      <h1
        class="text-[26px] leading-[1.05] font-medium tracking-[-0.03em] min-[700px]:text-[32px] lg:text-[36px]"
      >
        Michał<br />Paczków
      </h1>
      {
        /*
          The terminal line ships finished and still: the design's typing is
          replay-on-click, not autoplay, so the sentence is server-rendered and
          correct with no JavaScript at all — there is no first-paint flash left
          to guard against, and nothing here has to run before the parser gets
          to it. `client:idle` because the only thing hydration adds is the click
          that replays the animation.
        */
      }
      <HeroTerminal
        client:idle
        line={t("home.hero.terminal")}
        subline={t("home.hero.subline")}
      />
    </div>

    <SectionNav
      class="relative z-[1]"
      ariaLabel={t("home.nav.sections")}
      items={navItems}
    />

    <div class="relative z-[1] mt-auto flex flex-col gap-7">
      <WritingHeatmap
        posts={heatmapPosts}
        i18n={{
          locale,
          heatmapTitle: t("home.heatmap.title"),
          noWriting: t("home.heatmap.noWriting"),
        }}
      />
      <SidebarLinks ariaLabel={t("common.links")} />
    </div>
  </Fragment>

  <Fragment slot="content">
    <div class="flex flex-col gap-[56px] min-[700px]:gap-[72px]">
      <section id="writing" class="flex scroll-mt-6 flex-col">
        <div class="flex items-baseline justify-between pb-3">
          <h2
            class="text-sub text-[11px] font-medium tracking-[0.08em] uppercase"
          >
            {t("common.writing")}
          </h2>
          <a
            href={writingHref}
            class="text-sub hover:text-ink touch:active:text-ink flex items-center gap-1.5 text-[13px] transition-colors duration-150"
          >
            {t("common.allWriting")}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class={postListClass}>
          {
            rows.map((row) => (
              <PostRow
                href={row.href}
                title={row.title}
                description={row.description}
                date={row.date}
                readTime={row.readTime}
              />
            ))
          }
        </div>
      </section>

      <ExperienceTimeline
        heading={t("home.experience.heading")}
        content={work}
      />
    </div>
  </Fragment>
</Layout>
