---
import { render } from "astro:content";

import { getRelativeLocaleUrl } from "astro:i18n";
import ArticleToc from "@/components/ArticleToc.svelte";
import Prose from "@/components/Prose.astro";
import {
  type ArticleRouteProps,
  getArticleStaticPaths,
} from "@/helpers/page-data.ts";
import {
  findTranslation,
  getLocaleLinks,
  getPostsByLang,
  getSortedByDate,
  getWritingIndexUrl,
} from "@/helpers/posts.ts";
import { useTranslations } from "@/i18n/utils.ts";
import Layout from "@/layouts/Base.astro";
import type { Lang } from "@/models.ts";

export const getStaticPaths = getArticleStaticPaths;

const { entry, currentPost, posts } = Astro.props as ArticleRouteProps;
const lang = currentPost.lang;
const t = useTranslations(lang);
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((heading) => heading.depth === 2);

// The index the eyebrow, the breadcrumb and the footer all show is the post's
// place in its own locale's list, newest first — the same ordering the archive
// and the home page number their rows by.
const localePosts = getSortedByDate(getPostsByLang(posts, lang));
const position = localePosts.findIndex((post) => post.id === currentPost.id);
const olderPost = localePosts[position + 1];

const toIndexLabel = (zeroBased: number) =>
  String(zeroBased + 1).padStart(2, "0");

// Frontmatter dates are plain `YYYY-MM-DD`, so they coerce to UTC midnight and
// the ISO prefix is the authored day in every timezone.
const isoDate = currentPost.date.toISOString().slice(0, 10);

const getLocalizedPostUrl = (targetLang: Lang) => {
  if (targetLang === lang) return currentPost.url;
  return findTranslation(posts, currentPost, targetLang)?.url;
};

const { alternates, languageLinks } = getLocaleLinks(getLocalizedPostUrl);

const crumbLinkClass =
  "transition-[color] duration-150 hover:text-ink touch:active:text-ink";
const monoLabelClass =
  "text-mute font-mono text-[11px] tracking-[0.08em] uppercase";
const footerLinkClass =
  "text-sub flex flex-col gap-1.5 no-underline transition-[color] duration-150 hover:text-ink touch:active:text-ink";
---

<Layout
  title={currentPost.title}
  lang={lang}
  languageLinks={languageLinks}
  alternates={alternates}
>
  <Fragment slot="breadcrumb">
    <nav
      aria-label={t("common.breadcrumb")}
      class="flex items-center gap-2 whitespace-nowrap"
    >
      <a href={getRelativeLocaleUrl(lang)} class={crumbLinkClass}>
        {t("article.crumbHome")}
      </a>
      <span class="text-line2" aria-hidden="true">/</span>
      <a href={getWritingIndexUrl(lang)} class={crumbLinkClass}>
        {t("article.crumbWriting")}
      </a>
    </nav>
  </Fragment>

  <div
    class="px-5 pt-[88px] pb-16 min-[700px]:px-4 min-[700px]:pt-[112px] min-[700px]:pb-24"
  >
    {
      /*
        The design's `62ch` measures 617px in Geist but only 587px in Inter,
        which rewraps the title and shortens every line. The measure is pinned in
        px so the column, the line breaks and the header height stay put
        whichever sans is loaded.
      */
    }
    <div class="relative mx-auto w-full max-w-[617px]">
      <header class="border-line flex flex-col gap-[18px] border-b pb-7">
        <h1
          id="article-title"
          class="m-0 scroll-mt-[120px] text-[30px] leading-[1.1] font-medium tracking-[-0.03em] text-balance min-[700px]:text-[34px] lg:text-[38px]"
        >
          {currentPost.title}
        </h1>
        <p class="text-sub m-0 text-[17px] leading-[1.55] text-pretty">
          {currentPost.description}
        </p>
        <div class="text-mute flex gap-4 font-mono text-xs">
          <time datetime={isoDate}>{isoDate}</time>
          <span class="text-line2" aria-hidden="true">·</span>
          <span>{currentPost.readTime} {t("common.readTime")}</span>
          <span class="text-line2" aria-hidden="true">·</span>
          <span>{lang.toUpperCase()}</span>
        </div>
      </header>

      {
        /*
          Renders both forms of the contents list: the rail is absolutely
          positioned against the column above, so its place in the markup only
          decides where the inline fallback lands — directly under the header.
        */
      }
      {
        currentPost.toc && tocHeadings.length > 0 && (
          <ArticleToc
            client:load
            headings={tocHeadings.map(({ slug, text }) => ({
              id: slug,
              text,
            }))}
            i18n={{ label: t("article.onThisPage"), top: t("article.top") }}
          />
        )
      }

      <article class="pt-4">
        <Prose figureLabel={t("article.figureLabel")}>
          <Content />
        </Prose>
      </article>

      <footer
        class="border-line mt-14 grid grid-cols-2 gap-6 border-t pt-5 text-[13px]"
      >
        <a href={getWritingIndexUrl(lang)} class={footerLinkClass}>
          <span class={monoLabelClass}>← {t("common.allWriting")}</span>
          <span class="text-ink font-medium">{t("article.backToList")}</span>
        </a>
        {
          /*
            The oldest post in a locale has nothing to point at, so the cell is
            dropped rather than faked; the grid keeps the remaining link left.
          */
        }
        {
          olderPost && (
            <a href={olderPost.url} class={`${footerLinkClass} text-right`}>
              <span class={monoLabelClass}>{t("article.older")}</span>
              <span class="text-ink font-medium">{olderPost.title}</span>
            </a>
          )
        }
      </footer>
    </div>
  </div>
</Layout>
