---
import Prose from "@/components/Prose.astro";
import Layout from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const essayCollection = await getCollection("essays");

  const essays = await Promise.all(
    essayCollection.map(async (essay) => {
      const { remarkPluginFrontmatter } = await render(essay);

      return {
        params: { slug: essay.id },
        props: {
          post: {
            type: "essay" as const,
            readTime: remarkPluginFrontmatter.minutesRead,
            ...essay,
          },
        },
      };
    }),
  );

  return essays;
}

const props = Astro.props;
const { post } = props;
const { Content, headings } = await render(post);
const tocHeadings = [
  { slug: "article-title", text: post.data.title, depth: 1 },
  ...headings.filter((h) => h.depth === 2),
];
---

<Layout title={post.data.title}>
  <div class="relative">
    {
      post.data.toc && tocHeadings.length > 0 && (
        <aside class="hidden lg:block absolute left-8 top-0 h-full">
          <nav id="toc" class="sticky top-(--nav-height)">
            <ul class="m-0 flex list-none flex-col gap-0 p-0">
              {tocHeadings.map((heading) => (
                <li
                  data-scroll-section={heading.slug}
                  class="toc-item relative"
                >
                  <button type="button" class="toc-button group/toc relative flex w-full cursor-pointer items-center py-2 pr-24">
                    <span class="toc-line block h-px w-6 bg-sand-7 transition-all duration-200 ease-out group-hover/toc:w-9 group-hover/toc:bg-sand-12 dark:bg-sand-8 dark:group-hover/toc:bg-sand-12" />
                  </button>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }

    <div class="mx-auto w-full max-w-prose px-4">
      <nav
        aria-label="Breadcrumb"
        class="mb-12 flex items-center gap-2 text-sm text-sand-11"
      >
        <a href="/" class="transition-colors hover:text-sand-12">Home</a>
        <span class="text-sand-9">/</span>
        <a href="/writing" class="transition-colors hover:text-sand-12">
          All Writing
        </a>
      </nav>

      <header class="mb-8">
        <h1
          id="article-title"
          class="font-display text-sand-12 text-4xl md:text-5xl font-normal leading-[1.05] tracking-tight"
        >
          {post.data.title}
        </h1>
        <div class="mt-5 flex items-center gap-3 text-sm text-sand-10">
          <time datetime={post.data.date.toISOString()} class="tabular-nums">
            {
              post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
          {
            post.readTime && (
              <>
                <span class="text-sand-8">·</span>
                <span class="tabular-nums">{post.readTime} min read</span>
              </>
            )
          }
        </div>
      </header>

      <hr class="mb-12 border-0 border-t border-sand-4 dark:border-sand-6" />

      <article>
        <Prose>
          <Content />
        </Prose>
      </article>
    </div>
  </div>
</Layout>

<style>
  .toc-item.active .toc-line {
    width: 36px;
    background: var(--color-sand-12);
  }
</style>

<script>
  const { hash } = window.location;
  let observerEnabled = true;

  document.addEventListener("DOMContentLoaded", () => {
    const items = Array.from(
      document.querySelectorAll<HTMLLIElement>("#toc .toc-item"),
    );
    if (items.length === 0) return;

    const activeItem =
      items.find(
        (item) =>
          item.getAttribute("data-scroll-section") === hash.replace("#", ""),
      ) ?? items[0];

    activeItem?.classList.add("active");

    items.forEach((item) => {
      const button = item.querySelector("button");
      button?.addEventListener("click", () => {
        const id = item.getAttribute("data-scroll-section");
        const section = document.getElementById(id ?? "");

        items.forEach((l) => l.classList.remove("active"));
        item.classList.add("active");

        if (section) {
          observerEnabled = false;
          section?.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
          setTimeout(() => {
            observerEnabled = true;
          }, 1000);
        }
      });
    });
  });

  const headers = document.querySelectorAll("#article-title, h2");
  const items = Array.from(
    document.querySelectorAll<HTMLLIElement>("#toc .toc-item"),
  );

  const seen = new WeakSet();

  const isAtBottom = () => {
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    const windowHeight = window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight;
    return scrollTop + windowHeight >= documentHeight - 50;
  };

  const observer = new IntersectionObserver(
    (entries) => {
      if (!observerEnabled) return;

      if (isAtBottom()) {
        items.forEach((item) => item.classList.remove("active"));
        if (items.length > 0) {
          items[items.length - 1].classList.add("active");
        }
        return;
      }

      entries.forEach((entry) => {
        if (!seen.has(entry.target)) {
          seen.add(entry.target);
          return;
        }

        const current = items.findIndex((item) => {
          const id = item.getAttribute("data-scroll-section");
          return id === entry.target.id;
        });

        if (entry.isIntersecting) {
          items.forEach((item, index) => {
            if (index === current) {
              item.classList.add("active");
            } else {
              item.classList.remove("active");
            }
          });
        } else if (
          entry.intersectionRatio === 0 &&
          entry.boundingClientRect.bottom >= 0 &&
          current > 0
        ) {
          items[current].classList.remove("active");
          items[current - 1].classList.add("active");
        }
      });
    },
    {
      root: null,
      rootMargin: "0px 0px -50% 0px",
    },
  );

  headers.forEach((header) => observer.observe(header));
</script>
