---
import { useTranslations } from "@/i18n/utils.ts";
import Layout from "@/layouts/TwoColumn.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

// Astro renders 404.astro once to dist/404.html, which Cloudflare serves on any
// unmatched path (see wrangler.jsonc `not_found_handling`). Because it is a
// single static file it can't detect the requested locale, so it renders in the
// default language — the language switcher still points at each locale's home.
const lang = "en" as const;
const t = useTranslations(lang);

const homeHref = getRelativeLocaleUrl("en");
const writingHref = getRelativeLocaleUrl("en", "writing");

const exits = [
  { href: homeHref, label: t("notFound.home") },
  { href: writingHref, label: t("notFound.writing") },
];

// Only `color` transitions: `transition-colors` would also ease `border-color`,
// leaving these two hairlines fading behind every other one on a theme toggle.
const exitRowClass =
  "tap-highlight border-line text-ink flex items-center justify-between border-b py-3.5 text-[15px] no-underline transition-[color] duration-150 hover:text-sub focus-visible:-outline-offset-2 touch:active:text-sub";
---

<Layout
  title={t("notFound.pageTitle")}
  lang={lang}
  languageLinks={{
    en: getRelativeLocaleUrl("en"),
    pl: getRelativeLocaleUrl("pl"),
  }}
  asideGap={36}
  asideGapPhone={36}
  asideGapBottomPhone={24}
  asideSticky={false}
>
  <Fragment slot="sidebar">
    <nav
      aria-label={t("common.breadcrumb")}
      class="text-sub flex items-center gap-2 font-mono text-xs"
    >
      <a
        href={homeHref}
        class="hover:text-ink touch:active:text-ink no-underline transition-[color] duration-150"
      >
        home
      </a>
      <span class="text-line2">/</span>
      <span class="text-ink">?</span>
    </nav>
    <dl class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-2 font-mono text-xs">
      <dt class="text-mute">{t("notFound.meta.statusLabel")}</dt>
      <dd class="text-ink">404</dd>
      <dt class="text-mute">{t("notFound.meta.nodeLabel")}</dt>
      <dd class="text-sub">{t("notFound.meta.nodeValue")}</dd>
      <dt class="text-mute">{t("notFound.meta.linksLabel")}</dt>
      <dd class="text-sub">{t("notFound.meta.linksValue")}</dd>
    </dl>
  </Fragment>

  {
    /* Pinned in px rather than the design's `52ch`: `ch` is a font metric, and
       Inter's is narrower than the Geist the design was drawn in, so 52ch capped
       the column 25px short. 517px is what the design's cap rendered at. */
  }
  <div class="flex max-w-[517px] flex-col gap-7" slot="content">
    <p class="text-mute font-mono text-[11px] tracking-[0.08em] uppercase">
      {t("notFound.eyebrow")}
    </p>
    {
      /* The caret sits inside the heading so it wraps with the last line rather
         than stranding itself on a line of its own. */
    }
    <h1
      class="text-[32px] leading-[1.1] font-medium tracking-[-0.03em] text-balance lg:text-[36px]"
    >
      {t("notFound.title")}<span
        aria-hidden="true"
        class="caret bg-ink ml-[0.2em] inline-block h-0.5 w-[0.5em] align-[-0.02em]"
      ></span>
    </h1>
    <p class="text-sub text-pretty">{t("notFound.body")}</p>
    <nav aria-label={t("common.links")} class="border-line flex flex-col border-t">
      {
        exits.map(({ href, label }) => (
          <a href={href} class={exitRowClass}>
            <span>{label}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </nav>
  </div>
</Layout>

<style>
  /* `steps(1)` rather than a fade: a terminal caret is on or off, never
     half-lit. Reduced motion gets the same caret, held solid. */
  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .caret {
    animation: caret-blink 1.1s steps(1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
