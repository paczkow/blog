---
import "@fontsource-variable/inter";

import Head from "@/components/Head.astro";
import TopBar from "@/components/TopBar.astro";
import { SITE } from "config";
import type { Lang } from "@/models.ts";

import "@/styles/global.css";

interface Props {
  title: string;
  lang?: Lang;
  languageLinks?: Partial<Record<Lang, string>>;
  alternates?: { lang: Lang; href: string }[];
}

const { title, lang = "en", languageLinks, alternates = [] } = Astro.props;

// The `.dark` class on <html> is set before first paint by the inline script in
// Head.astro, so nothing below waits on Preferences hydrating.
---

<!doctype html>
<html lang={lang} class="bg-bg text-ink m-0 w-full">
  <Head title={title} alternates={alternates} description={SITE.desc[lang]} />
  <body class="bg-bg text-ink relative m-0 min-h-screen w-full overflow-x-clip">
    <TopBar lang={lang} languageLinks={languageLinks}>
      <slot name="breadcrumb" slot="breadcrumb" />
    </TopBar>
    {
      /*
        Only the horizontal container lives here. Vertical padding differs per
        page (104/96 on the two-column pages, 112/96 on the article), so each
        layout owns it — see TwoColumn.astro.

        1184 = the design's 1152px content box plus its 16px side padding. The
        design is content-box, we are border-box, so the cap has to carry the
        padding the child re-applies (`lg:px-4`) for the columns to land where
        the design puts them.
      */
    }
    <div class="relative z-10 mx-auto w-full max-w-[1184px]">
      <slot />
    </div>
  </body>
</html>
