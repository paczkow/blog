---
import "@fontsource-variable/inter";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/fraunces/wght-italic.css";

import Head from "@/components/Head.astro";
import { NeuralBackground } from "@/components/NeuralBackground.tsx";

import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en" class="bg-sand-1 m-0 w-full">
  <Head title={title} />
  <body class="m-0 w-full">
    {isHome && <NeuralBackground client:only="react" />}
    <svg
      aria-hidden="true"
      class="fixed inset-0 w-full h-full pointer-events-none z-0 opacity-[0.035] mix-blend-multiply dark:mix-blend-screen dark:opacity-[0.06]"
    >
      <filter id="grain">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.9"
          numOctaves="2"
          stitchTiles="stitch"></feTurbulence>
        <feColorMatrix type="saturate" values="0"></feColorMatrix>
      </filter>
      <rect width="100%" height="100%" filter="url(#grain)"></rect>
    </svg>
    <nav
      class="fixed top-0 left-0 right-0 mx-auto max-w-3xl lg:max-w-6xl h-14 z-50 backdrop-blur-md bg-sand-1/70"
    >
      <div class="mx-auto max-w-6xl h-full px-4 flex items-center">
        {
          !isHome && (
            <a
              href="/"
              class="text-sand-12 px-4 font-medium hover:text-sand-11"
            >
              Michał Paczków
            </a>
          )
        }
      </div>
    </nav>
    <div class="relative z-10 mx-auto max-w-3xl lg:max-w-6xl pt-(--nav-height) pb-(--page-bottom)">
      <slot />
    </div>
  </body>
</html>
